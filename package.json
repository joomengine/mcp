{
  "name": "@joomengine/mcp",
  "version": "0.2.0",
  "description": "Operate JoomEngine Playground workspaces and build Joomla extensions with JCB.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joomengine/mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "joomengine-playground-mcp": "./dist/cli.js"
  },
  "exports": "./dist/server.js",
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "skills": "node scripts/skills.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run skills && npm run build"
  },
  "dependencies": {
    "@joomengine/joomla-mcp": "^0.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "fflate": "^0.8.3",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "~7.0.2"
  }
}
